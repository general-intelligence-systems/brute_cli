#!/usr/bin/env ruby
# frozen_string_literal: true

require "brute_cli"
require "optparse"

options = { cwd: Dir.pwd, session_id: nil }

OptionParser.new do |opts|
  opts.banner = "Usage: brute [options] [prompt]"
  opts.on("-d", "--directory DIR", "Working directory") { |d| options[:cwd] = File.expand_path(d) }
  opts.on("-s", "--session ID", "Resume a session")    { |id| options[:session_id] = id }
  opts.on("--list-sessions", "List saved sessions")    { options[:list] = true }
  opts.on("-v", "--version", "Show version")           { puts "brute #{Brute::VERSION}"; exit }
  opts.on("-h", "--help", "Show help")                 { puts opts; exit }
end.parse!

# ── List sessions ──

if options[:list]
  sessions = Brute::Session.list
  if sessions.empty?
    puts "No saved sessions."
  else
    title_style = Lipgloss::Style.new.bold(true).foreground(BruteCLI::Styles::PURPLE)
    id_style    = Lipgloss::Style.new.foreground(BruteCLI::Styles::CYAN)
    time_style  = Lipgloss::Style.new.foreground(BruteCLI::Styles::DIM)

    sessions.each do |s|
      id    = id_style.render(s[:id][0..7])
      title = title_style.render(s[:title] || "(untitled)")
      time  = time_style.render(s[:saved_at].to_s)
      puts "  #{id}  #{title}  #{time}"
    end
  end
  exit
end

# ── Collect prompt ──

prompt = ARGV.join(" ")
prompt = $stdin.read.strip if prompt.empty? && !$stdin.tty?

# ── Run ──

repl = BruteCLI::REPL.new(options)

begin
  if prompt.empty?
    # Interactive mode
    repl.run_interactive
  else
    # Single prompt mode
    repl.run_once(prompt)
    puts
  end
rescue Interrupt
  $stderr.puts "\nAborted."
  exit 130
rescue => e
  BruteCLI.error(e.message)
  $stderr.puts "  #{e.backtrace&.first}" if ENV["BRUTE_DEBUG"]
  exit 1
end
